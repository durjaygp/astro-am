---
import "../styles/global.css";
import { cities } from "../data/cities";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="logo" href="/">PermAdCost</a>

        <nav class="main-nav">
          <div class="nav-item has-dropdown">
            <span class="nav-link" role="button" tabindex="0">
              Ad Costs <span class="dropdown-arrow">▾</span>
            </span>
            <div class="dropdown">
              <div class="dropdown-inner">
                {cities.map((c) => (
                  <a href={`/perm-ad-cost/${c.slug}`}>{c.city}, {c.stateAbbr}</a>
                ))}
                <div class="dropdown-divider"></div>
                <a href="/quote" class="dropdown-cta">Get a Quote →</a>
              </div>
            </div>
          </div>

          <div class="nav-item has-dropdown">
            <span class="nav-link" role="button" tabindex="0">
              Tools <span class="dropdown-arrow">▾</span>
            </span>
            <div class="dropdown">
              <div class="dropdown-inner">
                <a href="/perm-timeline-calculator">Timeline Calculator</a>
                <a href="/wage-transparency-laws-by-state">Wage Transparency Laws</a>
              </div>
            </div>
          </div>
        </nav>

        <div class="nav-actions">
          <a class="nav-cta" href="/quote">Request a Quote</a>
        </div>

        <button class="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <slot />

    <footer>
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="logo" href="/">PermAdCost</a>
            <p>PERM Sunday newspaper ad placement, priced in the open. No hidden markups, no surprise fees.</p>
          </div>
          <div class="footer-col">
            <h4>Ad Costs</h4>
            {cities.map((c) => (
              <a href={`/perm-ad-cost/${c.slug}`}>{c.city}, {c.stateAbbr}</a>
            ))}
          </div>
          <div class="footer-col">
            <h4>Tools</h4>
            <a href="/perm-timeline-calculator">Timeline Calculator</a>
            <a href="/wage-transparency-laws-by-state">Wage Transparency Laws</a>
          </div>
          <div class="footer-col">
            <h4>Get Started</h4>
            <a href="/quote">Request a Quote</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p class="footer-copy">&copy; 2026 PermAdCost.com</p>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const mobileToggle = document.querySelector('.mobile-toggle') as HTMLButtonElement;
      const masthead = document.querySelector('.masthead') as HTMLElement;

      mobileToggle?.addEventListener('click', () => {
        const isOpen = masthead.classList.toggle('menu-open');
        mobileToggle.setAttribute('aria-expanded', String(isOpen));
      });

      // Mobile dropdown toggles
      const dropdownItems = document.querySelectorAll('.nav-item.has-dropdown');
      dropdownItems.forEach((item) => {
        const trigger = item.querySelector('.nav-link') as HTMLElement;
        trigger?.addEventListener('click', (e) => {
          if (window.innerWidth <= 768) {
            e.preventDefault();
            dropdownItems.forEach((other) => {
              if (other !== item) other.classList.remove('dropdown-open');
            });
            item.classList.toggle('dropdown-open');
          }
        });
      });

      // Close mobile menu on nav link click
      document.querySelectorAll('.dropdown-inner a').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth <= 768) {
            masthead.classList.remove('menu-open');
            mobileToggle.setAttribute('aria-expanded', 'false');
          }
        });
      });

      // FAQ Accordion
      document.querySelectorAll('.faq-question').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.parentElement as HTMLElement;
          const wasOpen = item.classList.contains('open');
          // Close all
          document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
          // Toggle clicked
          if (!wasOpen) item.classList.add('open');
        });
      });
    </script>
  </body>
</html>
