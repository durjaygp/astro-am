---
import Layout from "../../layouts/Layout.astro";
import Seo from "../../components/Seo.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "PERM Recruitment Timeline Calculator",
  applicationCategory: "BusinessApplication",
  description:
    "Calculate PERM labor certification recruitment deadlines: Sunday newspaper ad dates, SWA job order window, quiet period, and earliest filing date.",
};
---

<Layout>
  <Fragment slot="head">
    <Seo
      title="PERM Recruitment Timeline Calculator | PermAdCost.com"
      description="Free tool to calculate your PERM recruitment deadlines: Sunday newspaper ad dates, SWA job order window, 30-day quiet period, and earliest filing date."
      canonicalPath="/perm-timeline-calculator/"
      jsonLd={jsonLd}
    />
  </Fragment>

  <main>
    <span class="eyebrow">&#10003; Based on 20 CFR &sect; 656.17 recruitment rules</span>

    <h1>PERM Recruitment Timeline Calculator</h1>
    <p class="lede">
      Enter the date you plan to start recruitment. We'll calculate your
      Sunday newspaper ad dates, SWA job order window, quiet period, and the
      earliest date you can file.
    </p>

    <form id="calc-form" style="margin: 1.75rem 0; display: flex; gap: 0.75rem; align-items: end; flex-wrap: wrap;">
      <label style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--slate);">
        Recruitment start date
        <input
          type="date"
          id="start-date"
          required
          style="display: block; margin-top: 0.35rem; padding: 0.6rem; border: 1px solid var(--hairline); background: white; font-family: 'IBM Plex Sans', sans-serif;"
        />
      </label>
      <button type="submit" class="cta" style="border: none; cursor: pointer;">Calculate</button>
    </form>

    <div id="results" style="display: none;">
      <div class="rate-notice">
        <div class="figure" id="filing-date-out">&mdash;</div>
        <p>Earliest possible filing date (ETA Form 9089), assuming all recruitment steps are completed on schedule and the required quiet period is observed.</p>
      </div>

      <div class="section-label">Recruitment schedule</div>
      <ul class="market-list" id="schedule-list"></ul>

      <p class="lede" style="margin-top: 2rem; font-size: 0.85rem;">
        This is a planning estimate, not legal advice. Actual deadlines
        depend on your specific case, occupation type (professional vs.
        non-professional), and any additional recruitment steps required.
        Confirm your filing timeline with your attorney.
      </p>
    </div>

    <a class="cta" href="/quote" style="margin-top: 1rem;">Request a Quote for Your Ads</a>
  </main>

  <script>
    const form = document.getElementById("calc-form") as HTMLFormElement;
    const resultsEl = document.getElementById("results") as HTMLDivElement;
    const filingDateOut = document.getElementById("filing-date-out") as HTMLDivElement;
    const scheduleList = document.getElementById("schedule-list") as HTMLUListElement;

    function nextSunday(d: Date): Date {
      const result = new Date(d);
      const day = result.getDay();
      const diff = (7 - day) % 7 || 7;
      result.setDate(result.getDate() + diff);
      return result;
    }

    function addDays(d: Date, days: number): Date {
      const result = new Date(d);
      result.setDate(result.getDate() + days);
      return result;
    }

    function fmt(d: Date): string {
      return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const startInput = (document.getElementById("start-date") as HTMLInputElement).value;
      if (!startInput) return;

      // Parse as local date, not UTC, to avoid off-by-one day issues
      const [y, m, d] = startInput.split("-").map(Number);
      const start = new Date(y, m - 1, d);

      const firstSunday = nextSunday(start);
      const secondSunday = nextSunday(firstSunday);
      const swaEnd = addDays(start, 30);

      // Recruitment "ends" on the latest of: second Sunday ad, SWA end
      const recruitmentEnd = secondSunday > swaEnd ? secondSunday : swaEnd;

      // 30-day quiet period after recruitment ends
      const earliestFiling = addDays(recruitmentEnd, 30);

      filingDateOut.textContent = fmt(earliestFiling);

      scheduleList.innerHTML = "";
      const rows: [string, Date][] = [
        ["SWA job order posted (start)", start],
        ["First Sunday newspaper ad", firstSunday],
        ["Second Sunday newspaper ad", secondSunday],
        ["SWA job order posting complete (30 days)", swaEnd],
        ["Quiet period ends / earliest filing date", earliestFiling],
      ];

      for (const [label, date] of rows) {
        const li = document.createElement("li");
        const a = document.createElement("span");
        a.textContent = label;
        a.style.fontFamily = "'Newsreader', Georgia, serif";
        a.style.fontSize = "1rem";
        const span = document.createElement("span");
        span.textContent = fmt(date);
        span.className = "price";
        li.appendChild(a);
        li.appendChild(span);
        scheduleList.appendChild(li);
      }

      resultsEl.style.display = "block";
    });
  </script>
</Layout>
